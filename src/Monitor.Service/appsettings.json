{
    "Monitor": {
        "HttpPort": 5188,
        "HardwareSampleIntervalMs": 1000,
        "AggregateIntervalSeconds": 10,
        "HistoryRetentionDays": 30,
        "TopNDefault": 10,
        "EtwBufferSizeMb": 4,
        "EnableEtwTargetEventLogging": false,
        "EtwTargetEventLoggingProtocolFilter": "all",
        "AddressClassification": {
            "TreatPrivateAddressesAsLan": true,
            "TreatLocalSubnetsAsLan": true,
            "TreatLoopbackAsLoopback": true,
            "AdditionalLanCidrs": [],
            "AdditionalWanCidrs": []
        },
        "ListenAddress": "127.0.0.1"
    },
    "Serilog": {
        "MinimumLevel": {
            "Default": "Warning",
            "Override": {
                "Microsoft": "Warning",
                "System": "Warning"
            }
        }
    }
}
